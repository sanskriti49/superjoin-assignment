# Copy to .env and edit. Every value below is optional; the defaults work.

# SQLite needs no setup. PostgreSQL works too:
# DATABASE_URL=postgresql://user:password@localhost:5432/fact_knowledge_layer
DATABASE_URL=sqlite:///./fact_knowledge.db

# Read the PDFs in starter-datasets/ on first launch. Set to false to start empty.
LOAD_STARTER_DATASET=true

# 0 reads every page of an uploaded document.
MAX_PAGES_PER_DOCUMENT=0
MAX_UPLOAD_MB=100

# Where the web interface is served from, for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional model-assisted extraction. Leave USE_LLM=false to run entirely
# offline; the pattern extractor is the primary path either way, and any model
# output is still checked against the page text before it is stored.
USE_LLM=false
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
